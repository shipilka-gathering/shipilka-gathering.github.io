---
import H1 from "../../../components/H1.astro";
import { getAllArticles } from "../../../data/articles";
import { getEventEntries } from "../../../data/events";
import {
  localeCodes,
  localeDefinitions,
  type LocaleCode,
} from "../../../i18n/config";
import { getMessages } from "../../../i18n/messages";
import {
  buildAlternateLinks,
  getArticlesIndexPath,
  getDefaultAlternateHref,
  getEventsIndexPath,
  getLanguagePagePath,
  getLocaleRoot,
} from "../../../i18n/routing";
import Layout from "../../../layouts/Layout.astro";

export function getStaticPaths() {
  return localeCodes.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: LocaleCode };
const messages = getMessages(locale);

const localizedLanguagePaths = Object.fromEntries(
  localeCodes.map((code) => [code, getLanguagePagePath(code)]),
) as Partial<Record<LocaleCode, string>>;
const localeRoots = Object.fromEntries(
  localeCodes.map((code) => [code, getLocaleRoot(code)]),
) as Record<LocaleCode, string>;
const eventsIndexPaths = Object.fromEntries(
  localeCodes.map((code) => [code, getEventsIndexPath(code)]),
) as Record<LocaleCode, string>;
const articlesIndexPaths = Object.fromEntries(
  localeCodes.map((code) => [code, getArticlesIndexPath(code)]),
) as Record<LocaleCode, string>;

const alternateLinks = buildAlternateLinks(localizedLanguagePaths);
const xDefaultHref = getDefaultAlternateHref(
  localizedLanguagePaths,
  getLanguagePagePath(locale),
);

const [eventEntries, articles] = await Promise.all([
  getEventEntries(),
  getAllArticles(),
]);
const eventSlugs = [...new Set(eventEntries.map((entry) => entry.data.slug))];
const articleLocalesBySlug = Object.fromEntries(
  Array.from(
    articles.reduce((map, article) => {
      map.set(article.slug, article.availableLocales);
      return map;
    }, new Map<string, LocaleCode[]>()),
  ),
) as Record<string, LocaleCode[]>;
---

<Layout
  locale={locale}
  messages={messages}
  title={`${messages.languagePage.title} | ${messages.site.name}`}
  description={messages.languagePage.description}
  languagePageHref={getLanguagePagePath(locale)}
  alternateLinks={alternateLinks}
  canonicalPath={getLanguagePagePath(locale)}
  xDefaultHref={xDefaultHref}
>
  <section
    class="m-auto max-w-240 rounded-[20px] border border-[rgba(255,255,255,0.3)] bg-[rgba(255,255,255,0.9)] p-6 shadow-[0_18px_42px_rgba(0,26,77,0.14),inset_0_0_0_0.5px_rgba(12,51,136,0.15)] max-[720px]:p-5"
  >
    <H1>{messages.languagePage.title}</H1>
    <p class="m-0 leading-[1.7] text-[rgba(11,29,63,0.8)]">
      {messages.languagePage.description}
    </p>
    <p class="mt-3 mb-0 text-sm leading-[1.7] text-[rgba(11,29,63,0.75)]">
      {messages.languagePage.fallbackNote}
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {
        localeDefinitions.map((definition) => (
          <a
            data-language-link
            data-locale={definition.code}
            href={getLocaleRoot(definition.code)}
            class={`rounded-[18px] border p-5 no-underline shadow-[0_12px_28px_rgba(0,26,77,0.08)] [transition:transform_0.15s_ease,box-shadow_0.2s_ease,border-color_0.2s_ease] hover:-translate-y-[1px] hover:shadow-[0_16px_34px_rgba(0,26,77,0.12)] ${
              definition.code === locale
                ? "border-[#0c3388] bg-[rgba(12,51,136,0.08)]"
                : "border-[rgba(12,51,136,0.16)] bg-white"
            }`}
            aria-current={definition.code === locale ? "page" : undefined}
          >
            <div class="flex items-start justify-between gap-3">
              <div class="text-xl font-bold leading-[1.3] text-[#0b1d3f]">
                {definition.label}
              </div>
              {
                definition.code === locale && (
                  <span class="rounded-full bg-[#0c3388] px-3 py-1 text-xs font-semibold text-white">
                    {messages.languagePage.currentBadge}
                  </span>
                )
              }
            </div>
            <p class="mt-3 mb-0 leading-[1.7] text-[rgba(11,29,63,0.8)]">
              {messages.languagePage.intro}
            </p>
            <p class="mt-3 mb-0 text-sm leading-[1.7] text-[#34558f]">
              {messages.languagePage.destinationLabel}:
              <span data-language-destination class="ml-1 break-all">
                {getLocaleRoot(definition.code)}
              </span>
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <script
    define:vars={{
      localeRoots,
      eventsIndexPaths,
      articlesIndexPaths,
      eventSlugs,
      articleLocalesBySlug,
    }}
  >
    const params = new URLSearchParams(window.location.search);
    const view = params.get("view");
    const slug = params.get("slug");
    const validViews = new Set(["home", "events", "event", "articles", "article"]);
    const validEventSlugs = new Set(eventSlugs);

    function resolveTarget(locale) {
      const root = localeRoots[locale] ?? "/";
      if (!view || !validViews.has(view)) {
        return root;
      }

      if (view === "home") {
        return root;
      }

      if (view === "events") {
        return eventsIndexPaths[locale] ?? root;
      }

      if (view === "event") {
        if (!slug || !validEventSlugs.has(slug)) {
          return root;
        }

        return `${eventsIndexPaths[locale]}${slug}/`;
      }

      if (view === "articles") {
        return articlesIndexPaths[locale] ?? root;
      }

      if (view === "article") {
        if (!slug) {
          return root;
        }

        const availableLocales = articleLocalesBySlug[slug];
        if (!Array.isArray(availableLocales)) {
          return root;
        }

        if (availableLocales.includes(locale)) {
          return `${articlesIndexPaths[locale]}${slug}/`;
        }

        return articlesIndexPaths[locale] ?? root;
      }

      return root;
    }

    document.querySelectorAll("[data-language-link]").forEach((element) => {
      if (!(element instanceof HTMLAnchorElement)) {
        return;
      }

      const locale = element.dataset.locale;
      if (!locale) {
        return;
      }

      const target = resolveTarget(locale);
      element.href = target;

      const destination = element.querySelector("[data-language-destination]");
      if (destination) {
        destination.textContent = target;
      }
    });
  </script>
</Layout>
