---
import EventCard from "../../components/EventCard.astro";
import H2 from "../../components/H2.astro";
import Rules from "../../components/Rules.astro";
import { getLocalizedEvents } from "../../data/events";
import { localeCodes, type LocaleCode } from "../../i18n/config";
import { getMessages } from "../../i18n/messages";
import {
  buildAlternateLinks,
  getDefaultAlternateHref,
  getEventPath,
  getEventsIndexPath,
  getLanguagePageHref,
  getLocaleRoot,
} from "../../i18n/routing";
import HomeLayout from "../../layouts/HomeLayout.astro";

export function getStaticPaths() {
  return localeCodes.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: LocaleCode };
const messages = getMessages(locale);
const events = await getLocalizedEvents(locale);
const latestEvent = events[0] ?? null;

const localizedHomePaths = Object.fromEntries(
  localeCodes.map((code) => [code, getLocaleRoot(code)]),
) as Partial<Record<LocaleCode, string>>;
const alternateLinks = buildAlternateLinks(localizedHomePaths);
const latestEventHref = latestEvent
  ? getEventPath(locale, latestEvent.slug)
  : getEventsIndexPath(locale);
const xDefaultHref = getDefaultAlternateHref(
  localizedHomePaths,
  getLocaleRoot(locale),
);
---

<HomeLayout
  locale={locale}
  messages={messages}
  title={messages.home.title}
  description={messages.home.description}
  languagePageHref={getLanguagePageHref(locale, { view: "home" })}
  alternateLinks={alternateLinks}
  canonicalPath={getLocaleRoot(locale)}
  xDefaultHref={xDefaultHref}
>
  <main class="flex flex-col">
    <h1 class="hidden">{messages.home.title}</h1>
    <section class="mt-50 md:mt-0">
      <img
        src="/images/hero-image.png"
        alt={messages.home.heroImageAlt}
        loading="lazy"
        class="w-full [mask-image:linear-gradient(to_bottom,black_90%,transparent_100%)]"
      />
    </section>
    <div
      class="relative z-10 mx-4 flex flex-col gap-20 pt-6 pb-12 md:mx-16 md:gap-80 xl:mx-32 2xl:mx-64 max-[720px]:pt-4 max-[720px]:pb-10"
    >
      <section class="relative grid gap-3 overflow-hidden">
        <div class="m-4 flex items-center gap-4 md:m-16 xl:m-32">
          <div>
            <div
              class="text-3xl font-bold leading-[1.3] md:text-5xl 2xl:text-8xl"
            >
              <span class="text-slate-50">
                {messages.home.heroLines[0]}<br />
                {messages.home.heroLines[1]}<br />
                {messages.home.heroLines[2]}
              </span>
            </div>
            <p
              class="my-8 text-[clamp(1rem,3vw,2rem)] leading-[1.7] text-[#f2f5ff]"
            >
              {messages.home.heroBody}
            </p>
          </div>
        </div>
      </section>

      <section>
        <div class="my-8 flex flex-wrap items-center justify-center gap-8">
          <a
            class="inline-flex items-center justify-center gap-[0.35rem] rounded-[12px] border border-[rgba(255,255,255,0.6)] px-10 py-6 text-[clamp(1rem,3vw,2rem)] font-bold text-[#1b1b1b] no-underline shadow-[0_10px_20px_rgba(244,194,31,0.3)] [background:linear-gradient(120deg,#f4c21f,#ffd773)] [transition:transform_0.15s_ease,box-shadow_0.2s_ease] hover:-translate-y-[1px] hover:shadow-[0_12px_30px_rgba(244,194,31,0.4)]"
            href={latestEventHref}
          >
            {messages.home.primaryCta}
          </a>
          <a
            class="inline-flex items-center justify-center gap-[0.35rem] rounded-[12px] border border-[rgba(12,51,136,0.2)] bg-[rgba(255,255,255,0.9)] px-10 py-6 text-[clamp(1rem,3vw,2rem)] font-bold text-[#0b1d3f] no-underline shadow-none [transition:transform_0.15s_ease,box-shadow_0.2s_ease] hover:-translate-y-[1px] hover:shadow-[0_12px_30px_rgba(244,194,31,0.4)]"
            href="https://vrc.group/SIPILK.2143"
          >
            {messages.home.secondaryCta}
          </a>
        </div>
        <div
          class="rounded-[20px] border border-[rgba(255,255,255,0.3)] bg-[rgba(255,255,255,0.9)] p-6 shadow-[0_18px_42px_rgba(0,26,77,0.14),inset_0_0_0_0.5px_rgba(12,51,136,0.15)] max-[720px]:p-5"
        >
          <div
            class="mb-4 flex items-baseline justify-between gap-4 max-[720px]:flex-col max-[720px]:items-start"
          >
            <div>
              <H2>{messages.home.latestSectionTitle}</H2>
            </div>
            <a
              class="font-bold text-[#0b1d3f] no-underline hover:underline"
              href={getEventsIndexPath(locale)}
            >
              {messages.home.allEventsLink}
            </a>
          </div>
          {
            latestEvent ? (
              <EventCard event={latestEvent} compact={false} messages={messages} />
            ) : (
              <p class="m-0 text-[rgba(11,29,63,0.8)]">{messages.events.empty}</p>
            )
          }
        </div>
      </section>

      <Rules messages={messages} />

      <section class="justify-self-center text-center text-[#f2f5ff]">
        <H2>
          <span class="text-[#f2f5ff]">
            {messages.home.closingLines[0]}<br />{messages.home.closingLines[1]}
          </span>
        </H2>

        <div class="my-8 flex flex-wrap items-center justify-center gap-8">
          <a
            class="inline-flex items-center justify-center gap-[0.35rem] rounded-[12px] border border-[rgba(255,255,255,0.6)] px-10 py-6 text-[clamp(1rem,3vw,2rem)] font-bold text-[#1b1b1b] no-underline shadow-[0_10px_20px_rgba(244,194,31,0.3)] [background:linear-gradient(120deg,#f4c21f,#ffd773)] [transition:transform_0.15s_ease,box-shadow_0.2s_ease] hover:-translate-y-[1px] hover:shadow-[0_12px_30px_rgba(244,194,31,0.4)]"
            href={latestEventHref}
          >
            {messages.home.primaryCta}
          </a>
          <a
            class="inline-flex items-center justify-center gap-[0.35rem] rounded-[12px] border border-[rgba(12,51,136,0.2)] bg-[rgba(255,255,255,0.9)] px-10 py-6 text-[clamp(1rem,3vw,2rem)] font-bold text-[#0b1d3f] no-underline shadow-none [transition:transform_0.15s_ease,box-shadow_0.2s_ease] hover:-translate-y-[1px] hover:shadow-[0_12px_30px_rgba(244,194,31,0.4)]"
            href="https://vrc.group/SIPILK.2143"
          >
            {messages.home.secondaryCta}
          </a>
        </div>
      </section>
    </div>

    <section>
      <div
        class="bg-[linear-gradient(#1a4da0_0%,#5056aa_30%)] pt-[20em] pb-[5em]"
      >
        <div
          class="[mask-image:linear-gradient(to_bottom,transparent_0%,black_15%,black_85%,transparent_100%)]"
        >
          <img
            class="w-full [mask-image:linear-gradient(transparent_0%,rgb(0_0_0_/_100%)_30%_70%,transparent_100%)]"
            src="/images/hero-bottom.png"
            alt={messages.home.heroBottomAlt}
            loading="lazy"
          />
        </div>
      </div>
    </section>
  </main>
</HomeLayout>
