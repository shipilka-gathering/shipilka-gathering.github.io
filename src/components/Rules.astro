---
import H2 from "./H2.astro";
import H3 from "./H3.astro";

import type { Messages } from "../i18n/messages";

const { tone = "light", messages } = Astro.props as {
  tone?: "light" | "dark";
  messages: Messages;
};

const isLight = tone === "light";
const textClass = isLight ? "text-[#f2f5ff]" : "text-[rgba(11,29,63,0.8)]";
const headingClass = isLight ? "text-[#f2f5ff]" : "text-[#0b1d3f]";
const sectionMedia = [
  {
    src: "/images/shipilka-is-watching.png",
    imageFirst: false,
    className:
      "hidden md:block max-h-[512px] justify-self-center rounded-r-[3rem] [mask-image:linear-gradient(to_right,rgba(0,0,0,0)_0%,rgba(0,0,0,1)_25%)]",
  },
  {
    src: "/images/shipilka-is-seeing.png",
    imageFirst: true,
    className:
      "hidden md:block max-h-[512px] justify-self-center rounded-l-[3rem] [mask-image:linear-gradient(to_right,rgba(0,0,0,1)_75%,rgba(0,0,0,0)_100%)]",
  },
  {
    src: "/images/shipilka-turns-upside-down.png",
    imageFirst: false,
    className:
      "hidden md:block max-h-[512px] justify-self-center rounded-r-[3rem] [mask-image:linear-gradient(to_right,rgba(0,0,0,0)_0%,rgba(0,0,0,1)_25%)]",
  },
];
---

<section class={`flex flex-col gap-8 ${isLight ? "mx-[10%] my-auto" : ""}`}>
  <div class="text-center">
    <H2 class="text-center"><span class={headingClass}>{messages.rules.title}</span></H2>
  </div>
  {
    messages.rules.sections.map((section, index) => {
      const media = sectionMedia[index];
      const text = (
        <div class={textClass}>
          <H3>{section.title}</H3>
          <ul class="grid gap-2 pl-6">
            {section.items.map((item) => (
              <li class={textClass}>
                <span>{item.text}</span>
                {
                  item.children && item.children.length > 0 && (
                    <ul class="mt-2 grid gap-2 pl-6">
                      {item.children.map((child) => (
                        <li class={textClass}>{child}</li>
                      ))}
                    </ul>
                  )
                }
              </li>
            ))}
          </ul>
          {section.footer && <p class={`mt-3 ${textClass}`}>{section.footer}</p>}
        </div>
      );
      const image = (
        <img
          src={media.src}
          alt={section.imageAlt}
          class={media.className}
        />
      );

      return (
        <div
          class={`flex items-center justify-center gap-8 max-[900px]:flex-col ${
            isLight ? "text-[#f2f5ff]" : "text-[#0b1d3f]"
          }`}
        >
          {media.imageFirst ? image : text}
          {media.imageFirst ? text : image}
        </div>
      );
    })
  }
</section>
