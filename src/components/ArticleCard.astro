---
import H3 from "./H3.astro";

import type { LocalizedArticle } from "../data/articles";
import { formatArticleDate } from "../i18n/format";
import { getArticlePath } from "../i18n/routing";

const { article } = Astro.props as {
  article: LocalizedArticle;
};

const formattedDate = formatArticleDate(article.locale, article.date);
---

<article
  class="rounded-[1rem] border border-[rgba(255,255,255,0.3)] bg-[rgba(255,255,255,0.9)] px-[1.3rem] py-[1.2rem] shadow-[0_12px_32px_rgba(0,26,77,0.12)]"
>
  <div class="flex items-baseline gap-[0.65rem]">
    <p class="m-0 font-bold text-[#34558f]">{formattedDate}</p>
  </div>
  <H3 class="mt-[0.2rem] mb-[0.4rem] text-[2rem] font-bold leading-[1.3] text-[#0b1d3f]">
    <a
      class="text-[inherit] no-underline hover:underline"
      href={getArticlePath(article.locale, article.slug)}
    >
      {article.title}
    </a>
  </H3>
  {
    article.excerpt && (
      <p class="m-0 leading-[1.7] text-[rgba(11,29,63,0.8)]">
        {article.excerpt}
      </p>
    )
  }
</article>
