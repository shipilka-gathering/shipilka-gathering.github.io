---
import LanguageButton from "./LanguageButton.astro";

import { externalLinks } from "../config/site";
import type { LocaleCode } from "../i18n/config";
import type { Messages } from "../i18n/messages";
import {
  getArticlesIndexPath,
  getEventsIndexPath,
  getLocaleRoot,
} from "../i18n/routing";

const {
  locale,
  languagePageHref,
  messages,
  overlay = false,
} = Astro.props as {
  locale: LocaleCode;
  languagePageHref: string;
  messages: Messages;
  overlay?: boolean;
};

const navItems = [
  { href: getLocaleRoot(locale), label: messages.nav.home },
  { href: externalLinks.vrchatGroup, label: messages.nav.vrchatGroup },
  { href: externalLinks.twitter, label: messages.nav.twitter },
  { href: externalLinks.discord, label: messages.nav.discord },
  { href: getEventsIndexPath(locale), label: messages.nav.events },
  { href: getArticlesIndexPath(locale), label: messages.nav.articles },
];

const headerClass = overlay
  ? "absolute z-10 flex w-full flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:px-12 md:py-12 [background:linear-gradient(to_top,transparent_0%,rgba(0,0,0,0.5)_100%)]"
  : "relative z-10 flex w-full flex-col gap-4 px-4 py-8 md:flex-row md:items-center md:px-12 md:py-12 [background:linear-gradient(to_top,transparent_0%,rgba(0,0,0,0.5)_100%)]";
---

<header class={headerClass}>
  <a
    class="inline-flex items-center gap-3 no-underline text-[inherit]"
    href={getLocaleRoot(locale)}
  >
    <img
      src="/images/logo-wide.png"
      alt={messages.site.logoAlt}
      loading="lazy"
      class="h-[52px] w-auto object-contain"
    />
  </a>
  <div class="flex flex-1 flex-col gap-3 md:items-end">
    <nav
      class="flex max-w-full items-center gap-2 overflow-x-auto whitespace-nowrap"
      aria-label={messages.nav.home}
    >
      {
        navItems.map((item) => (
          <a
            class="inline-flex shrink-0 rounded-[10px] px-[0.65rem] py-[0.4rem] font-semibold text-[#f2f5ff] no-underline [transition:background_0.2s_ease,transform_0.15s_ease] hover:-translate-y-[1px] hover:bg-[rgba(12,51,136,0.08)]"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
      <LanguageButton
        href={languagePageHref}
        class="shrink-0 whitespace-nowrap border-[rgba(255,255,255,0.6)] bg-[rgba(255,255,255,0.16)]"
      />
    </nav>
  </div>
</header>
